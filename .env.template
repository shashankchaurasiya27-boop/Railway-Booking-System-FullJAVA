# ===================================================================
# Railway Booking System - Environment Variables Template
# ===================================================================
# Copy this file and set your environment-specific values
# DO NOT commit this file with actual credentials to version control

# ===================================================================
# DATABASE CREDENTIALS
# ===================================================================
# Development
export DB_USERNAME=root
export DB_PASSWORD=your_dev_password

# Production (use secure secret management)
# export DB_URL=jdbc:mysql://prod-db.example.com:3306/railway_booking?useSSL=true
# export DB_USERNAME=prod_user
# export DB_PASSWORD=secure_prod_password

# ===================================================================
# SERVER CONFIGURATION
# ===================================================================
export SERVER_PORT=8080

# ===================================================================
# SPRING PROFILE
# ===================================================================
# Set active profile: dev, prod, test
export SPRING_PROFILES_ACTIVE=dev

# ===================================================================
# SSL/TLS (Production only)
# ===================================================================
# export SSL_KEYSTORE_PATH=/path/to/keystore.p12
# export SSL_KEYSTORE_PASSWORD=keystore_password

# ===================================================================
# LOGGING
# ===================================================================
# export LOG_PATH=/var/log/railway-booking
# export LOG_LEVEL=INFO

# ===================================================================
# USAGE
# ===================================================================
# 1. Copy this file: cp .env.template .env
# 2. Edit .env with your actual values
# 3. Source the file: source .env
# 4. Run the application: mvn spring-boot:run
#
# OR
#
# Run with inline environment variables:
# DB_USERNAME=root DB_PASSWORD=pass mvn spring-boot:run
#
# OR
#
# Run with profile selection:
# mvn spring-boot:run -Dspring-boot.run.profiles=prod
